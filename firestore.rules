rules_version = '2';

// الموقع يملك مشروع Firebase الخاص به، فأسماء المجموعات مجردة بلا سابقة.
// القراءة عامة لأن محتوى الموقع معروض للزوار، والكتابة تتطلب تسجيل الدخول.

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /siteInfo/{documentId} {
      allow read: if true;
      allow write: if signedIn();
    }

    match /siteContent/{documentId} {
      allow read: if true;
      allow write: if signedIn();
    }

    match /navLinks/{documentId} {
      allow read: if true;
      allow write: if signedIn();
    }

    match /principles/{documentId} {
      allow read: if true;
      allow write: if signedIn();
    }

    match /services/{documentId} {
      allow read: if true;
      allow write: if signedIn();
    }

    match /articles/{documentId} {
      allow read: if true;
      allow write: if signedIn();
    }

    match /testimonials/{documentId} {
      allow read: if true;
      allow write: if signedIn();
    }

    // طلبات الحجز تحمل بيانات شخصية حسّاسة: يُسمح بالإنشاء من النموذج العام،
    // ولا تُقرأ ولا تُعدّل إلا بعد تسجيل الدخول.
    match /bookingRequests/{documentId} {
      allow create: if request.resource.data.keys().hasAll([
        'name', 'email', 'phone', 'preferredService', 'preferredTime', 'message', 'createdAt'
      ])
      && request.resource.data.name is string
      && request.resource.data.email is string
      && request.resource.data.phone is string
      && request.resource.data.preferredService is string
      && request.resource.data.preferredTime is string
      && request.resource.data.message is string
      && request.resource.data.createdAt is string;
      allow read, update, delete: if signedIn();
    }
  }
}
