rules_version = '2';

// ملفات الموقع تعيش في مجلد site-assets داخل Cloud Storage.
// القراءة عامة لأن الصور تظهر للزوار، والكتابة تتطلب تسجيل الدخول
// وتقتصر على الصور بحجم أقصاه 5 ميغابايت.

service firebase.storage {
  match /b/{bucket}/o {
    match /site-assets/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
